{
  "default_route": "llm",
  "rules": [
    {
      "name": "speaker_playback",
      "route": "yandex",
      "match": {
        "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:хватит|стоп|пауза|останови(?:те)?|(?:останови(?:те)?|выключи(?:те)?|прекрати(?:те)?) (?:музыку|воспроизведение|песню|песни|трек|радио)|поставь(?:те)? на паузу|(?:продолжи(?:те)?|возобнови(?:те)?) (?:музыку|воспроизведение|песню|трек))[,\\s]*(?:пожалуйста)?[.!?]*\\s*$"
      }
    },
    {
      "name": "yandex_intercom",
      "route": "yandex",
      "match": {
        "contains_any": [
          "передай",
          "передайте",
          "передать",
          "скажи всем",
          "объявлен",
          "объяви",
          "трансляц",
          "транслир",
          "позвони",
          "позвонить",
          "переговор"
        ]
      }
    },
    {
      "name": "home_devices",
      "route": "home",
      "match": {
        "contains_all_groups": [
          [
            "свет",
            "ламп",
            "люстр",
            "розетк",
            "штор",
            "кондиционер",
            "термостат",
            "обогрев",
            "вентилятор",
            "пылесос",
            "телевизор",
            "датчик",
            "температур",
            "влажност"
          ],
          [
            "включ",
            "выключ",
            "открой",
            "закрой",
            "установ",
            "постав",
            "сделай",
            "прибав",
            "убав",
            "температур",
            "влажност",
            "состояни",
            "проверь",
            "горит",
            "работает"
          ]
        ],
        "contains_none": [
          "песню",
          "песни",
          "музыку",
          "радио",
          "трек"
        ]
      }
    },
    {
      "name": "yandex_services",
      "route": "yandex",
      "match": {
        "contains_any": [
          "погод",
          "прогноз",
          "температура",
          "температуру",
          "градус",
          "таймер",
          "будильник",
          "напоминание",
          "музык",
          "радио",
          "песн",
          "трек",
          "альбом",
          "плейлист",
          "исполнител",
          "который час",
          "сколько времени",
          "текущее время",
          "время сейчас",
          "какое время",
          "день недели",
          "какое сегодня число",
          "какая сегодня дата"
        ]
      }
    }
  ]
}
