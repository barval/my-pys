{
  "default_route": "llm",
  "rules": [
    {
      "name": "speaker_playback",
      "route": "yandex",
      "match": {
        "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:хватит|стоп|пауза|останови(?:те)?|(?:останови(?:те)?|выключи(?:те)?|прекрати(?:те)?) (?:музыку|воспроизведение|песню|песни|трек|радио)|поставь(?:те)? на паузу|(?:продолжи(?:те)?|возобнови(?:те)?) (?:музыку|воспроизведение|песню|трек))[,\\s]*(?:пожалуйста)?[.!?]*\\s*$"
      }
    },
    {
      "name": "speaker_controls",
      "route": "yandex",
      "match": {
        "contains_any": [
          "громче",
          "тише",
          "громкость",
          "дальше",
          "назад",
          "следующий трек",
          "предыдущий трек",
          "следующая песня",
          "предыдущая песня",
          "лайк",
          "дизлайк",
          "продолжи",
          "продолжай",
          "играй",
          "включи блютус",
          "выключи блютус",
          "включи bluetooth",
          "выключи bluetooth",
          "подключи телефон",
          "отключи телефон",
          "включи микрофон",
          "выключи микрофон",
          "отключи микрофон",
          "стереопар",
          "стерео пара",
          "включи везде"
        ]
      }
    },
    {
      "name": "yandex_intercom",
      "route": "yandex",
      "match": {
        "contains_any": [
          "передай",
          "передайте",
          "передать",
          "скажи всем",
          "объявлен",
          "объяви",
          "трансляц",
          "транслир",
          "позвон",
          "переговор",
          "набери",
          "вызови",
          "соедини",
          "свяжись",
          "рация",
          "домофон"
        ]
      }
    },
    {
      "name": "home_devices",
      "route": "home",
      "match": {
        "contains_all_groups": [
          [
            "свет",
            "ламп",
            "люстр",
            "розетк",
            "штор",
            "кондиционер",
            "термостат",
            "обогрев",
            "вентилятор",
            "пылесос",
            "телевизор",
            "датчик",
            "температур",
            "влажност",
            "камер",
            "ночник",
            "светильник",
            "подсветк",
            "кроват",
            "шкаф",
            "полк",
            "торшер",
            "бра",
            "гирлянд",
            "светодиод",
            "диодн",
            "rgb",
            "лент",
            "проектор",
            "увлажнитель",
            "котел",
            "занавес",
            "жалюзи",
            "ворота",
            "замок"
          ],
          [
            "включ",
            "выключ",
            "открой",
            "закрой",
            "установ",
            "постав",
            "сделай",
            "прибав",
            "убав",
            "температур",
            "влажност",
            "состояни",
            "проверь",
            "горит",
            "работает",
            "запусти",
            "переключ",
            "настрой",
            "отключ",
            "активир"
          ]
        ],
        "contains_none": [
          "песню",
          "песни",
          "музыку",
          "радио",
          "трек"
        ]
      }
    },
    {
      "name": "home_state",
      "route": "home",
      "match": {
        "contains_all_groups": [
          [
            "свет",
            "ламп",
            "люстр",
            "розетк",
            "штор",
            "подсветк",
            "кроват",
            "шкаф",
            "полк",
            "торшер",
