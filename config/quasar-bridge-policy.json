{
  "default_route": "llm",
  "rules": [
    {
      "name": "speaker_playback",
      "route": "yandex",
      "match": {
        "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:хватит|стоп|пауза|останови(?:те)?|(?:останови(?:те)?|выключи(?:те)?|прекрати(?:те)?) (?:музыку|воспроизведение|песню|песни|трек|радио)|поставь(?:те)? на паузу|(?:продолжи(?:те)?|возобнови(?:те)?) (?:музыку|воспроизведение|песню|трек))[,\\s]*(?:пожалуйста)?[.!?]*\\s*$"
      }
    },
    {
      "name": "speaker_controls",
      "route": "yandex",
      "match": {
        "contains_any": [
          "громче",
          "тише",
          "громкость",
          "дальше",
          "назад",
          "следующий трек",
          "предыдущий трек",
          "следующая песня",
          "предыдущая песня",
          "лайк",
          "дизлайк",
          "продолжи",
          "продолжай",
          "играй",
          "включи блютус",
          "выключи блютус",
          "включи bluetooth",
          "выключи bluetooth",
          "подключи телефон",
          "отключи телефон",
          "включи микрофон",
          "выключи микрофон",
          "отключи микрофон",
          "стереопар",
          "стерео пара",
          "включи везде"
        ]
      }
    },
    {
      "name": "yandex_intercom",
      "route": "yandex",
      "match": {
        "contains_any": [
          "передай",
          "передайте",
          "передать",
          "скажи всем",
          "объявлен",
          "объяви",
          "трансляц",
          "транслир",
          "позвони",
          "позвонить",
          "переговор"
        ]
      }
    },
    {
      "name": "home_devices",
      "route": "home",
      "match": {
        "contains_all_groups": [
          [
            "свет",
            "ламп",
            "люстр",
            "розетк",
            "штор",
            "кондиционер",
            "термостат",
            "обогрев",
            "вентилятор",
            "пылесос",
            "телевизор",
            "датчик",
            "температур",
            "влажност",
            "камер",
            "ночник",
            "светильник"
          ],
          [
            "включ",
            "выключ",
            "открой",
            "закрой",
            "установ",
            "постав",
            "сделай",
            "прибав",
            "убав",
            "температур",
            "влажност",
            "состояни",
            "проверь",
            "горит",
            "работает",
            "запусти",
            "переключ",
            "настрой",
            "отключ",
            "активир"
          ]
        ],
        "contains_none": [
          "песню",
          "песни",
          "музыку",
          "радио",
          "трек"
        ]
      }
    },
    {
      "name": "yandex_scenarios",
      "route": "yandex",
      "match": {
        "contains_all_groups": [
          [
            "сценари"
          ],
          [
            "включи",
            "запусти",
            "активир",
            "выполни"
          ]
        ]
      }
    },
    {
      "name": "yandex_services",
      "route": "yandex",
      "match": {
        "contains_any": [
          "погод",
          "прогноз",
          "температура",
          "температуру",
          "градус",
          "таймер",
          "будильник",
          "напоминание",
          "музык",
          "радио",
          "песн",
          "трек",
          "альбом",
          "плейлист",
          "исполнител",
          "который час",
          "сколько времени",
          "текущее время",
          "время сейчас",
          "какое время",
          "день недели",
          "какое сегодня число",
          "какая сегодня дата",
          "новост",
          "что нового",
          "подкаст",
          "аудиокниг",
          "сказк",
          "шум дожд",
          "звук дожд",
          "звуки природы",
          "медитац",
          "колыбельн",
          "календар",
          "встреч",
          "событи",
          "список покупок",
          "список дел",
          "заметк",
          "добавь в список",
          "что купить",
          "найди телефон",
          "такси",
          "закажи продукт",
          "заказ продукт",
          "доставк",
          "рецепт",
          "радионян",
          "телепрограмм",
          "переключи канал",
          "перевед",
          "перевод",
          "посчита",
          "сколько будет",
          "курс доллара",
          "курс евро",
          "курс валют",
          "пробк",
          "расстоян",
          "построй маршрут",
          "маршрут до",
          "как доехать",
          "сколько ехать",
          "доброе утро",
          "добрый вечер",
          "утреннее шоу",
          "вечернее шоу",
          "что ты умеешь",
          "настрой колонку"
        ]
      }
    }
  ]
}
