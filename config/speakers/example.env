# Пример профиля колонки. Скопируйте в local/speakers/<имя>.env и заполните
# реальными MAC/device ID/IP. Папка local/ не коммитится в git.
SPEAKER_NAME=speaker-a
SPEAKER_IP=192.168.1.101
SPEAKER_SUBNET=192.168.1
SPEAKER_SSH_PORT=2222
SPEAKER_ADB_PORT=5555
SPEAKER_PLATFORM=yandexmicro
SPEAKER_ROOM=комната A
SPEAKER_MODEL=Яндекс Станция Лайт
# cappuccino|mint|flamingo|chili|ultraviolet|lemon|blue|gray|black|white
SPEAKER_COLOR=mint
SPEAKER_DEVICE_ID=EXAMPLE000000000000000000000001
SPEAKER_MAC=02:00:00:00:00:01
LLM_BASE_URL=http://192.168.1.2:5002/v1
LLM_TOKEN_FILE=secrets/router-token-speaker-a
