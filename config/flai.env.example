# FLAI endpoint used by Quasar Bridge.
# Copy to ../.env or export these variables manually.
#
# Bridge goes through the invocation-normalizing proxy on 5001; the proxy
# forwards to FLAI on 5000. Start it with ./scripts/start-flai-proxy.sh.
FLAI_BASE_URL=http://192.168.1.2:5001/v1
FLAI_UPSTREAM_URL=http://127.0.0.1:5000/v1
FLAI_MODEL=flai-chat
FLAI_TOKEN_FILE=secrets/flai-token
