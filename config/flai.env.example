# External LLM used by Quasar Bridge.
# Copy to ../.env or export these variables manually.
#
# Any OpenAI-compatible endpoint works. The default is local FLAI.
LLM_BASE_URL=http://192.168.1.2:5000/v1
LLM_MODEL=flai-chat
LLM_TOKEN_FILE=secrets/flai-token

# Backward-compatible aliases used by older scripts.
FLAI_BASE_URL=http://192.168.1.2:5000/v1
FLAI_MODEL=flai-chat
FLAI_TOKEN_FILE=secrets/flai-token
