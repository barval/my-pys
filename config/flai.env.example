# External LLM used by Quasar Bridge.
# Copy to ../.env or export these variables manually.
#
# Bridge goes through the invocation-normalizing proxy on 5001; the proxy
# forwards to the real LLM (FLAI by default) on 5000.
LLM_BASE_URL=http://192.168.1.2:5001/v1
LLM_UPSTREAM_URL=http://127.0.0.1:5000/v1
LLM_MODEL=flai-chat
LLM_TOKEN_FILE=secrets/flai-token

# Backward-compatible aliases used by older scripts.
FLAI_BASE_URL=http://192.168.1.2:5001/v1
FLAI_UPSTREAM_URL=http://127.0.0.1:5000/v1
FLAI_MODEL=flai-chat
FLAI_TOKEN_FILE=secrets/flai-token
