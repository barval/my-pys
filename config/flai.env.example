# External LLM used by Quasar Bridge.
# Copy to ../.env or export these variables manually.
#
# The default goes through the local LLM router on port 5002. The router
# decides whether the request goes to FLAI or another OpenAI-compatible LLM.
LLM_BASE_URL=http://192.168.1.2:5002/v1
LLM_MODEL=flai-chat
LLM_TOKEN_FILE=secrets/router-token-speaker-a

# Backward-compatible aliases used by older scripts.
FLAI_BASE_URL=http://192.168.1.2:5002/v1
FLAI_MODEL=flai-chat
FLAI_TOKEN_FILE=secrets/router-token-speaker-a
