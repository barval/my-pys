{
  "response": {
    "max_sentences": 3,
    "max_chars": 400,
    "strip_markdown": true,
    "chunked": {
      "max_sentences": 100,
      "max_chars": 3000,
      "strip_markdown": true
    }
  },
  "routes": [
    {
      "name": "speaker-a",
      "token_file": "router-token-speaker-a",
      "session": {
        "mode": "server",
        "user": "voice",
        "idle_minutes": 30,
        "cleanup_keep": 3
      },
      "primary": {
        "base_url": "http://192.168.1.2:5000/v1",
        "api_key_file": "upstream-token-speaker-a",
        "model": "your-model",
        "history": "server",
        "timeout_seconds": 180,
        "fallback_on": [
          429,
          500,
          502,
          503,
          504
        ]
      },
      "fallbacks": [
        {
          "base_url": "https://api.example.com/v1",
          "api_key_file": "fallback-token-speaker-a",
          "model": "fallback-model",
          "history": "client",
          "timeout_seconds": 180,
          "fallback_on": [
            429,
            500,
            502,
            503,
            504
          ]
        }
      ]
    }
  ]
}
