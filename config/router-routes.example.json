{
  "response": {
    "max_sentences": 3,
    "max_chars": 400,
    "strip_markdown": true
  },
  "routes": [
    {
      "name": "speaker-a",
      "token_file": "router-token-speaker-a",
      "session": {
        "mode": "server",
        "user": "voice",
        "idle_minutes": 30,
        "cleanup_keep": 3
      },
      "primary": {
        "base_url": "http://192.168.1.2:5000/v1",
        "api_key_file": "flai-token-speaker-a",
        "model": "flai-chat",
        "history": "server",
        "timeout_seconds": 180,
        "fallback_on": [429, 500, 502, 503, 504]
      },
      "fallback": {
        "base_url": "https://api.orcarouter.ai/v1",
        "api_key": "sk-orca-replace-me",
        "model": "orcarouter/free",
        "history": "client",
        "timeout_seconds": 180,
        "fallback_on": [429, 500, 502, 503, 504]
      }
    }
  ]
}
