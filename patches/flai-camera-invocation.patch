         return {"messages": messages, "session_id": session_id}
 
+    @staticmethod
+    def _camera_question_text(message_text: str) -> str:
+        """Strip a voice-assistant invocation before asking about the snapshot.
+
+        Quasar Bridge can forward phrases like "спроси у ФЛАЙ: ..." or
+        "спроси нейросеть: ...". The vision model must see the actual question,
+        not the invocation, otherwise it answers "это не моя функция".
+        """
+        import re
+
+        text = str(message_text or "").strip()
+        text = re.sub(
+            r"^\s*(?:алиса[,\s]+)?(?:пожалуйста[,\s]+)?"
+            r"(?:спроси\s+(?:у\s+)?(?:флай|нейросет(?:ь|и)|свою\s+модель|у\s+своей\s+модели)"
+            r"|используй\s+нейросеть)"
+            r"[\s,:;.!?-]+",
+            "",
+            text,
+            flags=re.IGNORECASE,
+        )
+        return text.strip() or str(message_text or "").strip()
+
     def _camera_analysis_width(self) -> int:
         """Snapshot width the vision model reads: 384 px previews miss small animals."""
         return max(384, int(self.app.config.get("CAMERA_ANALYSIS_WIDTH", 1024)))
