* text=auto eol=lf

*.png binary
*.jpg binary
*.zip binary
*.gguf binary
vendor/station-tools/bin/* binary

# Keep upstream snapshots byte-for-byte; don't normalize their line endings
# and don't report their whitespace as our errors.
vendor/** -text
vendor/** whitespace=-trailing-space

# Patch files contain context lines with a single space by design.
patches/** -text
patches/** whitespace=-trailing-space
